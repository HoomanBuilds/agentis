SNCAST_PROFILE=sepolia

# Optional: override the RPC used by the sepolia profile.
# STARKNET_RPC_URL=https://starknet-sepolia.your-rpc-provider.example

# Deployer/admin address that will own all deployed contracts.
OWNER_ADDRESS=0x0123456789abcdef

# ERC20 token address used for payments (commonly ETH token on the target network).
PAYMENT_TOKEN_ADDRESS=0x0123456789abcdef

# AgentNFT mint fee in token base units.
MINT_FEE=0

# Optional backend wallet to authorize in AgentCredits.
# BACKEND_SPENDER=0x0123456789abcdef
