# Copy to .env.local and fill in values

# ============ Starknet Network ============
# Sepolia testnet RPC (set your primary; fallback RPCs are built into the app)
# Public options:
#   https://api.cartridge.gg/x/starknet/sepolia
#   https://free-rpc.nethermind.io/sepolia-juno/v0_7
NEXT_PUBLIC_STARKNET_RPC_URL=https://api.cartridge.gg/x/starknet/sepolia

# ============ Pinata (IPFS) ============
# Get from https://app.pinata.cloud/developers/api-keys
NEXT_PUBLIC_PINATA_JWT=your_pinata_jwt_here
NEXT_PUBLIC_PINATA_GATEWAY=https://gateway.pinata.cloud

# ============ DeepSeek (primary chat model) ============
# Get from https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your-deepseek-key-here

# ============ OpenAI (optional, for embeddings) ============
# OPENAI_API_KEY=sk-your-openai-key-here

# ============ ChromaDB ============
# URL to your ChromaDB instance
# Run locally: docker run -p 8000:8000 chromadb/chroma
CHROMA_URL=http://localhost:8000

# ============ ChromaDB Cloud ============
# If CHROMA_API_KEY is set, it connects to Chroma Cloud (defaults to https://api.trychroma.com)
# CHROMA_URL is ignored when using Cloud
# CHROMA_API_KEY=your_chroma_api_key
# CHROMA_TENANT=default_tenant
# CHROMA_DATABASE=default_database

# ============ Backend Wallet (Server-side only) ============
# Starknet account for server-side operations:
# - Authorized spending of credits (spendCredits, useSessionCredit)
# - Registering agent wallets with RevenueShare contract
# - Recording chat interactions for leaderboards
# - Minting agent NFTs
#
# IMPORTANT:
# - Keep these secure, never expose in client code
# - Must be set as authorized spender on AgentCredits contract
#
BACKEND_ACCOUNT_ADDRESS=0x_your_starknet_account_address
BACKEND_PRIVATE_KEY=0x_your_starknet_private_key

NEXT_PUBLIC_BASE_URL=https://agentis-mocha.vercel.app
